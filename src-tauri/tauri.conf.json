{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoForge",
  "version": "0.1.0",
  "identifier": "io.github.blanco1010.photoforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PhotoForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Juan Camilo",
    "shortDescription": "Editor de fotografía no destructivo",
    "longDescription": "PhotoForge abre fotografías, las revela sin tocar nunca el archivo original y las exporta. Todo el procesamiento ocurre en local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
